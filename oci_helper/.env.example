# =============================================================================
# OCI Helper - 环境变量配置示例
#
# 使用方式：
#   1. 复制此文件为 .env
#      cp .env.example .env
#   2. 修改 .env 中的配置值
#   3. 所有环境变量均以 OCI_HELPER_ 前缀标识
# =============================================================================

# ---- 部署选项 ----

# GHCR 镜像标签；生产环境可固定为具体版本，例如 0.0.2
OCI_HELPER_IMAGE_TAG=latest

# ---- 必填项 ----

# Web 管理面板初始登录账号；在管理页修改后以数据库中的值为准
OCI_HELPER_WEB_ACCOUNT=admin

# Web 管理面板初始登录密码（首次启动必须设置强密码；管理页保存凭据后可移除）
OCI_HELPER_WEB_PASSWORD=

# ---- 可选项（以下为默认值）----

# 服务监听端口
OCI_HELPER_SERVER_PORT=8888

# Docker Compose 的宿主机绑定地址；仅在已有防火墙和 HTTPS 反代时改为 0.0.0.0
OCI_HELPER_BIND_ADDRESS=127.0.0.1

# JWT 密钥（留空时会在数据目录生成并持久化 .oci-helper-secret）
OCI_HELPER_JWT_SECRET=

# 数据加密密钥（留空时会在数据目录生成并持久化 .oci-helper-data-key）
OCI_HELPER_DATA_ENCRYPTION_KEY=

# SQLite 数据库文件路径
OCI_HELPER_DB_PATH=./data/oci-helper.db

# OCI 私钥文件存储目录
OCI_HELPER_KEY_DIR_PATH=./keys

# JWT 令牌过期时间（小时）
OCI_HELPER_JWT_EXPIRE_HOURS=24

# IP 登录失败封禁阈值（次数）
OCI_HELPER_IP_BAN_THRESHOLD=5

# IP 封禁时长（分钟）
OCI_HELPER_IP_BAN_MINUTES=30

# 只有部署在可信反向代理后才开启代理 IP 请求头
OCI_HELPER_TRUST_PROXY_HEADERS=false

# 跨域来源，多个来源用逗号分隔；同源部署保持为空
OCI_HELPER_CORS_ORIGINS=

# 后台 OCI 调用最大并发数
OCI_HELPER_TASK_WORKER_COUNT=8

# API 未指定时的创建实例任务最大尝试次数；0 表示不限次数
OCI_HELPER_CREATE_TASK_MAX_ATTEMPTS=1000

# 目标 CIDR 换 IP 的执行间隔和最大尝试次数
OCI_HELPER_CHANGE_IP_INTERVAL_SECONDS=10
OCI_HELPER_CHANGE_IP_MAX_ATTEMPTS=120

# OCI SDK 单次请求超时（秒）
OCI_HELPER_OCI_REQUEST_TIMEOUT_SECONDS=120

# 日志
OCI_HELPER_LOG_LEVEL=INFO
OCI_HELPER_LOG_FILE_PATH=./logs/oci-helper.log
